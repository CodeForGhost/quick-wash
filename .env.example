# Supabase -> Settings -> API. Both values are safe in the browser; row level
# security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Needed for exactly one thing:
# creating the auth account behind an agent, shop staff or admin record.
# Never expose it to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (FR-018): notifications that reach a phone with the site closed.
# Generate the pair once with `npx web-push generate-vapid-keys`. The public
# half is safe in the browser; the private half is SERVER ONLY - never commit it.
# The subject is a contact the push services can reach if the sender misbehaves.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@quickwash.lk
