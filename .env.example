# Supabase -> Settings -> API. Both values are safe in the browser; row level
# security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Needed for exactly one thing:
# creating the auth account behind an agent, shop staff or admin record.
# Never expose it to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
